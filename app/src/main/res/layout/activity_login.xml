<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de Login
    ScrollView
     └─ LinearLayout (vertical)
         ├─ FrameLayout: cabecera con la onda verde y huellitas
         └─ LinearLayout: título, campos, "Recordarme", botón y enlace al registro
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".ui.auth.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Cabecera con onda ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <!-- La onda se estira a todo el ancho (fitXY) -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/bg_onda_login" />

            <!-- Huellitas decorativas (como un patrón) -->
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="24dp"
                android:layout_marginTop="40dp"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:rotation="-20"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="36dp"
                android:layout_marginTop="30dp"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:rotation="25"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="120dp"
                android:layout_marginTop="120dp"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:rotation="15"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="90dp"
                android:layout_marginTop="140dp"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:rotation="-30"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="30dp"
                android:layout_marginTop="165dp"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:rotation="35"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <!-- Huella principal dentro de un círculo blanco -->
            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="72dp"
                android:background="@drawable/bg_circulo_blanco">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/login_huella_descripcion"
                    app:srcCompat="@drawable/ic_huella"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>
        </FrameLayout>

        <!-- ===== Formulario ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <!-- Título grande alineado a la izquierda -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_bienvenida"
                android:textColor="?attr/colorOnSurface"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/login_subtitulo"
                android:textColor="@android:color/darker_gray"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/campo_email"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/campo_password"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:hintEnabled="false"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Casilla "Recordarme" -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbRecordarme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/login_recordarme" />

            <!-- Botón principal tipo "píldora" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/login_boton_ingresar"
                android:textSize="16sp"
                app:cornerRadius="28dp" />

            <!-- "¿No tienes cuenta? Regístrate" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_sin_cuenta"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/tvIrRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:padding="4dp"
                    android:text="@string/login_ir_registro"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
