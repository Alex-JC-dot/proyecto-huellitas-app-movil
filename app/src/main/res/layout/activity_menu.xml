<?xml version="1.0" encoding="utf-8"?>
<!--
    Menú principal (Huellitas)
    ScrollView
     └─ LinearLayout (vertical)
         ├─ FrameLayout: cabecera verde con huellitas, marca y saludo
         └─ MaterialCardView: tarjeta blanca que sube sobre la cabecera
             └─ secciones con botones hacia cada pantalla + cerrar sesión
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    tools:context=".ui.menu.MenuActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Cabecera ===== -->
        <FrameLayout
            android:id="@+id/cabecera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde_pistacho"
            android:paddingBottom="96dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="36dp"
                android:alpha="0.3"
                android:importantForAccessibility="no"
                android:rotation="-25"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="110dp"
                android:layout_marginTop="22dp"
                android:alpha="0.3"
                android:importantForAccessibility="no"
                android:rotation="20"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="120dp"
                android:layout_marginTop="40dp"
                android:alpha="0.3"
                android:importantForAccessibility="no"
                android:rotation="-15"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="96dp"
                android:alpha="0.3"
                android:importantForAccessibility="no"
                android:rotation="30"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="40dp"
                android:layout_marginTop="120dp"
                android:alpha="0.3"
                android:importantForAccessibility="no"
                android:rotation="10"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <!-- Huella grande de fondo, a la derecha -->
            <ImageView
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-30dp"
                android:layout_marginBottom="-70dp"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:rotation="-25"
                app:srcCompat="@drawable/ic_huella"
                app:tint="@color/white" />

            <LinearLayout
                android:id="@+id/contenidoCabecera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="24dp"
                android:paddingEnd="28dp">

                <!-- Marca: huella + "Huellitas" -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_huella"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/menu_marca"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/menu_marca_lema"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Saludo: el nombre se pone desde Kotlin -->
                <TextView
                    android:id="@+id/tvSaludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:textColor="@color/verde_olivo"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="¡Hola, Alex! 👋" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/menu_pregunta"
                    android:textColor="@color/verde_olivo"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ===== Tarjeta con las opciones: sube 72dp sobre la cabecera ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-72dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/menu_seccion_mascotas"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMisMascotas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:text="@string/menu_ver_mascotas"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_huella"
                    app:iconGravity="start"
                    app:iconPadding="12dp"
                    app:iconTint="?attr/colorPrimary"
                    app:strokeColor="@color/verde_pistacho"
                    app:strokeWidth="1.5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/menu_seccion_citas"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Dos botones lado a lado: cada uno ocupa la mitad (layout_weight) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMisCitas"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="@string/menu_mis_citas"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        app:cornerRadius="28dp"
                        app:strokeColor="@color/verde_pistacho"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAgendarCita"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:text="@string/menu_agendar_cita"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        app:cornerRadius="28dp"
                        app:strokeColor="@color/verde_pistacho"
                        app:strokeWidth="1.5dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/menu_seccion_veterinaria"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnServicios"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:text="@string/menu_servicios"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp"
                    app:cornerRadius="28dp"
                    app:strokeColor="@color/verde_pistacho"
                    app:strokeWidth="1.5dp" />

                <!-- Botón principal: cerrar sesión -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:text="@string/menu_cerrar_sesion"
                    android:textSize="16sp"
                    app:cornerRadius="28dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
