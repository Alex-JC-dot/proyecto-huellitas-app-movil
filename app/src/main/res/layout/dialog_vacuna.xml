<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo para registrar la vacuna aplicada (se abre al completar una cita de vacunación) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <!-- Lista desplegable que también permite escribir otra vacuna -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilVacuna"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/vacuna_campo">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actvVacuna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vacuna_proxima"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsRefuerzo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:checkedChip="@id/chipRefuerzo1Anio"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRefuerzo1Anio"
            style="@style/ChipHuellitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vacuna_refuerzo_1_anio" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRefuerzo6Meses"
            style="@style/ChipHuellitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vacuna_refuerzo_6_meses" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipRefuerzo1Mes"
            style="@style/ChipHuellitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vacuna_refuerzo_1_mes" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSinRefuerzo"
            style="@style/ChipHuellitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vacuna_sin_refuerzo" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
