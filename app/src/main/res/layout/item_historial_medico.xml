<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/fondo_suave"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFechaHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/verde_oscuro"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="📅 30 Oct 2026" />

            <TextView
                android:id="@+id/tvPesoHistorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_etiqueta"
                android:backgroundTint="@color/fondo_suave"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/verde_oscuro"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="⚖️ 12.5 kg" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="🩺 Diagnóstico: Dermatitis atópica estacional" />

        <TextView
            android:id="@+id/tvTratamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_principal"
            android:textSize="14sp"
            tools:text="💊 Tratamiento: Antihistamínico cada 12h + Champú antialérgico" />

        <TextView
            android:id="@+id/tvNotasHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="📝 Control en 15 días. Mantener dieta libre de granos." />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
